# =============================================================================
# Conduit Server — Environment Configuration
# Copy this file to .env and fill in all values before running.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://conduit:password@localhost:5432/conduit?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# MQTT Broker (Mosquitto)
# For local dev with docker-compose and TLS disabled, use tcp://
# For production with TLS enabled, use tls://
# -----------------------------------------------------------------------------
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=server
MQTT_PASSWORD=<generate: openssl rand -hex 16>

# -----------------------------------------------------------------------------
# JWT — Access tokens (stateless, 15 min expiry)
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=<generate: openssl rand -hex 32>

# -----------------------------------------------------------------------------
# Device Provisioning Token
# Compiled into ESP32 firmware. All devices share this token to self-register.
# Generate with: openssl rand -hex 24
# -----------------------------------------------------------------------------
PROVISIONING_TOKEN=<generate: openssl rand -hex 24>

# -----------------------------------------------------------------------------
# HTTP Server
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# CORS origin — must exactly match the browser-facing URL (no trailing slash)
CORS_ORIGIN=https://conduit.colinshirley.com

# -----------------------------------------------------------------------------
# TLS (optional for dev, required for production)
# Paths are relative to the server binary working directory.
# Leave blank to disable TLS on the Go server itself (use a reverse proxy instead).
# -----------------------------------------------------------------------------
TLS_CA_CERT_PATH=
TLS_SERVER_CERT_PATH=
TLS_SERVER_KEY_PATH=

# -----------------------------------------------------------------------------
# Behaviour flags
# -----------------------------------------------------------------------------

# Set to true to automatically run database migrations on startup.
RUN_MIGRATIONS=false

# Environment name — affects cookie Secure flag (development disables it).
# Values: development | production
ENV=development

# -----------------------------------------------------------------------------
# Token TTLs (Go duration strings: 15m, 1h, 720h, etc.)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# -----------------------------------------------------------------------------
# bcrypt cost factor (4 for tests, 12 for production)
# -----------------------------------------------------------------------------
BCRYPT_COST=12
